# ---- Stashify configuration ----
# Leave Clerk + MongoDB blank to run in fully-working DEMO mode.
# Set BOTH Clerk keys AND MONGODB_URI to enable real accounts + persistent data.

PORT=4000

# Clerk (https://dashboard.clerk.com -> API keys). Publishable key is public; secret key is server-only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional comma-separated browser origins allowed to present Clerk sessions (production).
CLERK_AUTHORIZED_PARTIES=

# MongoDB Atlas connection string. Use a dedicated database user, not your Atlas login.
MONGODB_URI=
MONGODB_DB=stashify

# Comma-separated verified Clerk emails that should get admin/fulfilment access.
ADMIN_EMAILS=

# Razorpay (test or live). When both are set, real Razorpay Checkout is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP email. When host/user/pass are set, real verification emails are sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Stashify <no-reply@stashify.shop>"

# JWT signing secret (auto-generated and stored if blank)
JWT_SECRET=

# Demo payment HMAC secret (only used when Razorpay keys are absent)
DEMO_PAY_SECRET=stashify-demo-secret
ADMIN_EMAIL=
